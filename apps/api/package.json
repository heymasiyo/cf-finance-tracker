{
  "name": "@repo/api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "echo yes | wrangler d1 migrations apply $(node scripts/get-db-name.mjs) --local",
    "cf-reset": "rm -rf .wrangler && pnpm db:migrate:dev"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@repo/schemas": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "hono-rate-limiter": "^0.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "jsonc-parser": "^3.3.1",
    "wrangler": "^4.110.0"
  }
}
