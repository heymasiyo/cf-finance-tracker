{
  "name": "cf-finance-tracker",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:api:typegen": "pnpm --filter @repo/api cf-typegen",
    "dev:api:reset": "pnpm --filter @repo/api cf-reset",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:migrate:dev": "pnpm --filter @repo/api db:migrate:dev"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0"
  },
  "packageManager": "pnpm@11.20.0"
}
